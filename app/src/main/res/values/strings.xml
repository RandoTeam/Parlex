    <!-- About App Section (v1.5.0-beta.1) -->
    <string name="about_app_tagline">Offline Neural Translation &amp; AR Intelligence</string>
    <string name="about_version_format">Version %1$s (Build %2$d • %3$s)</string>
    <string name="about_privacy_title">100% On-Device Neural Processing</string>
    <string name="about_privacy_desc">All neural translation, OCR, and speech models execute 100% locally on your hardware. Zero telemetry, zero cloud calls, complete privacy.</string>
    <string name="about_engines_section">Active On-Device Engines</string>
    <string name="about_engine_nmt_title">Hy-MT 1.5 (1.8B NMT)</string>
    <string name="about_engine_nmt_desc">High-quality neural translation runtime powered by llama.cpp</string>
    <string name="about_engine_stt_title">Whisper Tiny/Base STT</string>
    <string name="about_engine_stt_desc">Offline speech-to-text with Sherpa-ONNX and Silero VAD</string>
    <string name="about_engine_fast_nmt_title">Google ML Kit Fast NMT</string>
    <string name="about_engine_fast_nmt_desc">Ultra-fast ~30ms on-device camera and screen translation</string>
